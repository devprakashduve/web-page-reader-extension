{
  "manifest_version": 3,
  "name": "Kahoot Text Extractor",
  "version": "1.4",
  "description": "Extracts text from Kahoot! game pages and displays them in a sidebar.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://play.kahoot.it/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_open": true
  },
  "content_scripts": [
    {
      "matches": ["https://play.kahoot.it/*","https://kahoot.it/*/*","https://kahoot.it/"],
      "js": ["content.js"]
    }
  ]
}